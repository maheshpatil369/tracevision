# Copy this file to backend/.env and adjust as needed.
# Every variable has a safe default in app/config/settings.py; nothing here
# is required to get a local dev instance running.

APP_NAME=TRACEVISION
DEBUG=true

# Database (SQLite works out of the box; swap for postgresql://... in production)
DATABASE_URL=sqlite:///./data/tracevision.db

# Storage directories (relative to backend/ unless absolute)
UPLOAD_DIRECTORY=./data/uploads
PROCESSED_DIRECTORY=./data/processed
EVIDENCE_DIRECTORY=./data/evidence
REPORTS_DIRECTORY=./data/reports
MODEL_DIRECTORY=./models

# Computer vision models
YOLO_MODEL=yolov8n.pt
FACE_MODEL_FILENAME=face_landmarker.task

# Analysis defaults (can be overridden per-analysis via the API)
DETECTION_CONFIDENCE=0.4
DETECTION_IOU_THRESHOLD=0.5
FRAME_INTERVAL=5
MAX_PROCESSING_DIMENSION=960
TRACKER_MAX_AGE=15
TRACKER_IOU_THRESHOLD=0.3
FACE_MIN_DETECTION_CONFIDENCE=0.5

# Upload limits
MAX_UPLOAD_SIZE=2147483648

# CORS — comma-will-not-work; this is parsed as a JSON list by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security (change in any real deployment)
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=720
